PORT=5000
NODE_ENV=development
# Comma-separated list of allowed origins, or * for any
CORS_ORIGIN=*
RATE_LIMIT_MAX=60
MAX_HISTORY=500
# AI assistant (Google Gemini). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: pin a model; by default gemini-2.5-flash, falling back to the newest stable Flash
GEMINI_MODEL=
# Malware/URL/IP reputation (VirusTotal). Free key at https://www.virustotal.com (profile -> API key)
VIRUSTOTAL_API_KEY=
