{
  "manifest_version": 3,
  "name": "PhishShield AI",
  "version": "1.0.0",
  "description": "Check the current page, links and selected text for phishing and scams with PhishShield AI.",
  "action": {
    "default_title": "PhishShield AI",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "contextMenus", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://*/*"]
}
